#!/bin/sh /etc/rc.common
# Watches the power button: a quick tap sleeps/wakes the screen, a ~1s
# hold switches between the custom dashboard and the stock GL.iNet UI.
# Independent of citydash/gl_screen so the gesture works regardless of
# which one is currently showing.

START=96
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 /root/dashboard/button_watch.py
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

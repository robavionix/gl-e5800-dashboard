#!/bin/sh /etc/rc.common
# Custom UK/China dashboard on the built-in screen. See /root/dashboard/toggle.sh
# to switch back to the stock GL.iNet screen at any time.

START=95
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /root/dashboard/run.sh
    procd_set_param nice -10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
